# Allowlist-only skills for opencode in this repo: load ONLY .opencode/skills,
# never the global (~/.config/opencode/skills) or external (~/.claude, ~/.agents)
# scans. The global catalog alone overran the worker's 32k context.
# Mirrors the same exports in the Makefile so interactive and harness
# opencode invocations load an identical skill set. Run `direnv allow` once.
export OPENCODE_DISABLE_EXTERNAL_SKILLS=1
export OPENCODE_DISABLE_CLAUDE_CODE_SKILLS=1
