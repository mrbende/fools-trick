#!/usr/bin/env bash
# fools-trick site-specific overrides. Copy to config.local.sh (which is git-ignored) and set
# your real hostnames, LAN, and paths. config.sh sources this FIRST, so anything you export here
# wins the ${VAR:-default} fallbacks in config.sh -- you only need to set what differs.
#
#   cp scripts/config.local.sh.example scripts/config.local.sh
#   $EDITOR scripts/config.local.sh
#
# Nothing here is secret (no API keys -- the local servers use apiKey=dummy). This file exists so
# the public repo ships no one's real machine names or network. Keep config.local.sh out of git.

# --- your machines ---
# The orchestrator node (a deep-context box; a DGX Spark in the reference lab). Must resolve via
# /etc/hosts or DNS to its wired-LAN address. This is the ONLY remote node.
export FOOL_HOST="orchestrator.lan"        # e.g. fool, or 192.168.1.11, or a hostname you set

# The GPU workstation running the workers is assumed LOCAL (WORKER_URL is 127.0.0.1). If you serve
# the workers on a different box, override WORKER_URL instead.
# export WORKER_URL="http://192.168.1.20:8898"

# --- your LAN ---
# The wired-LAN subnet prefix. preflight uses it to confirm the orchestrator link is the fast LAN,
# not a VPN overlay (Tailscale etc). Include the trailing dot.
export LAN_PREFIX="192.168.1."

# --- your storage ---
# NAS mount holding the canonical model weights, shared over the LAN to both machines.
export NAS_MODELS="/mnt/nas/models"
# Where the orchestrator's spark serving-recipe clone lives on FOOL_HOST.
# export FOOL_SPARK_DIR="$HOME/Recipes/fools-trick-spark"

# --- optional: benchmark Google Sheets export ---
# Email to share the generated scorecard sheet with (needs GOOGLE_APPLICATION_CREDENTIALS). Empty
# leaves the sheet in the service account's own Drive.
# export BENCH_SHARE_WITH="you@example.com"
