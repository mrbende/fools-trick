{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "build",
  "subagent_depth": 1,
  "instructions": [
    "AGENTS.md"
  ],
  "compaction": {
    "auto": false,
    "prune": false
  },
  "experimental": {
    "primary_tools": ["skill"]
  },
  "agent": {
    "build": {
      "mode": "primary",
      "model": "fool-ds4/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/orchestrator.md}",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "external_directory": {
          "/tmp/fools-trick/scratch/**": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "general": "allow",
          "reviewer": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git reset --hard*": "ask",
          "git rebase -i*": "ask",
          "git rebase --interactive*": "ask",
          "git filter-branch*": "ask",
          "git filter-repo*": "ask",
          "terraform apply*": "ask",
          "terraform destroy*": "ask",
          "kubectl apply*": "ask",
          "kubectl delete*": "ask",
          "helm *": "ask",
          "pulumi up*": "ask",
          "pulumi destroy*": "ask",
          "npm publish*": "ask",
          "pnpm publish*": "ask",
          "yarn publish*": "ask",
          "cargo publish*": "ask",
          "poetry publish*": "ask",
          "twine upload*": "ask",
          "docker push*": "ask",
          "gh release create*": "ask",
          "gh pr merge*": "ask"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "model": "fool-ds4/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/orchestrator.md}",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "external_directory": {
          "/tmp/fools-trick/scratch/**": "allow"
        },
        "task": {
          "*": "deny",
          "explore": "allow",
          "reviewer": "allow"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "ls*": "allow",
          "cat*": "allow",
          "grep*": "allow",
          "rg*": "allow"
        }
      }
    }
  }
}
