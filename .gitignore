# opencode runtime
.opencode/cache/
.opencode/logs/
.opencode/node_modules/

# harness adapter JS deps (installed by npm; the owned core is Python)
/node_modules/
package-lock.json

# benchmark venv + isolated eval venvs
.bench-venv/
.bfcl-venv/

# python bytecode
__pycache__/
*.pyc

# benchmark outputs (also written to /tmp, but never track any that land in-repo)
/bench/results/
/bench/out/
report-*.md
*.jsonl

# local model/weight caches, scratch
/tmp/
*.log

# benchmark artifacts
scorecard-*.xlsx
manifest-*.json

# generated from opencode.base.json + config by `make config` -- derived, not a source
opencode.json

# credentials / secrets (never commit)
*.env
.env
*-service-account*.json
*credentials*.json
gcp-*.json

# durable memory store db (lives in ~/.local/share by default; ignore any stray in-tree copy)
*.db
*.db-wal
*.db-shm

# OS / editor cruft
.DS_Store
*~
*.swp
*.orig
*.bak
