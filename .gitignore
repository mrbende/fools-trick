# opencode runtime
.opencode/cache/
.opencode/logs/
.opencode/node_modules/

# benchmark venv + isolated eval venvs
.bench-venv/
.bfcl-venv/

# python bytecode
__pycache__/
*.pyc

# benchmark outputs (also written to /tmp, but never track any that land in-repo)
/bench/results/
/bench/out/
report-*.md
*.jsonl

# local model/weight caches, scratch
/tmp/
*.log

# benchmark artifacts
scorecard-*.xlsx
manifest-*.json

# site-specific overrides (your hostnames/LAN/paths) -- never commit; ship the .example instead
scripts/config.local.sh

# credentials / secrets (never commit)
*.env
.env
*-service-account*.json
*credentials*.json
gcp-*.json

# durable memory store db (lives in ~/.local/share by default; ignore any stray in-tree copy).
# NOTE: only the .db files -- NOT the plugin source in .opencode/memory/*.js
*.db
*.db-wal
*.db-shm
