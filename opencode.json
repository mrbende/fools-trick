{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": false,
  "default_agent": "build",
  "subagent_depth": 2,
  "instructions": ["AGENTS.md"],
  "provider": {
    "fool-ds4": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "fool",
      "options": {
        "baseURL": "http://fool:8888/v1",
        "apiKey": "dummy",
        "timeout": false
      },
      "models": {
        "deepseek-v4-flash-0731": {
          "name": "DeepSeek-V4-Flash-0731, abliterated",
          "tool_call": true,
          "reasoning": true,
          "limit": {
            "context": 384000,
            "output": 32768
          }
        }
      }
    },
     "magus": {
       "npm": "@ai-sdk/openai-compatible",
       "name": "magus (2x3080Ti)",
       "options": {
         "baseURL": "http://127.0.0.1:8898/v1",
         "apiKey": "dummy",
         "timeout": false
       },
      "models": {
        "qwen3.8-27b-obliterated": {
          "name": "Qwen3.8-27B-OBLITERATED i1-Q4_K_S",
          "tool_call": true,
          "attachment": true,
          "reasoning": true,
          "limit": {
            "context": 24576,
            "output": 32768
          }
        }
      }
    }
  },
  "model": "fool-ds4/deepseek-v4-flash-0731",
  "small_model": "magus/qwen3.8-27b-obliterated",
  "agent": {
    "build": {
      "mode": "primary",
      "model": "fool-ds4/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/orchestrator.md}",
      "temperature": 0.3,
      "permission": {
        "edit": "allow",
        "webfetch": "allow",
        "external_directory": {
          "/tmp/fools-trick/scratch/**": "allow"
        },
        "task": {
          "*": "allow"
        },
        "bash": {
          "*": "allow",
          "git push*": "ask",
          "git reset --hard*": "ask",
          "git rebase -i*": "ask",
          "git rebase --interactive*": "ask",
          "git filter-branch*": "ask",
          "git filter-repo*": "ask",
          "terraform apply*": "ask",
          "terraform destroy*": "ask",
          "kubectl apply*": "ask",
          "kubectl delete*": "ask",
          "helm *": "ask",
          "pulumi up*": "ask",
          "pulumi destroy*": "ask",
          "npm publish*": "ask",
          "pnpm publish*": "ask",
          "yarn publish*": "ask",
          "cargo publish*": "ask",
          "poetry publish*": "ask",
          "twine upload*": "ask",
          "docker push*": "ask",
          "gh release create*": "ask",
          "gh pr merge*": "ask"
        }
      }
    },
    "plan": {
      "mode": "primary",
      "model": "fool-ds4/deepseek-v4-flash-0731",
      "prompt": "{file:./prompts/orchestrator.md}",
      "temperature": 0.1,
      "permission": {
        "edit": "deny",
        "external_directory": {
          "/tmp/fools-trick/scratch/**": "allow"
        },
        "task": {
          "*": "allow",
          "implementer": "deny",
          "general": "deny"
        },
        "bash": {
          "*": "ask",
          "git status*": "allow",
          "git diff*": "allow",
          "git log*": "allow",
          "ls*": "allow",
          "cat*": "allow",
          "grep*": "allow",
          "rg*": "allow"
        }
      }
    }
  }
}
